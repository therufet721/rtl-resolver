{
  "name": "@rtl-resolver/css",
  "version": "0.2.0",
  "description": "Direction-safe CSS analysis and logical-property suggestions.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "postcss": ">=8"
  },
  "peerDependenciesMeta": {
    "postcss": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8"
  },
  "author": "Rufat Arzumanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/therufet721/rtl-resolver.git",
    "directory": "packages/css"
  },
  "homepage": "https://github.com/therufet721/rtl-resolver#readme",
  "bugs": {
    "url": "https://github.com/therufet721/rtl-resolver/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
